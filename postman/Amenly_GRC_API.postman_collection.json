{
  "info": {
    "_postman_id": "a1b2c3d4-2026-4a1a-9f2e-amenlygrc0001",
    "name": "Amenly GRC API",
    "description": "Professional, ready-to-run collection for the Amenly GRC compliance platform.\n\n## How to run\n1. Import this file into Postman.\n2. The collection ships with working defaults in **Collection Variables** (baseUrl = http://localhost:8001/api/v1, and the Zedny demo credentials). Adjust `host`, `adminEmail`, `adminPassword`, `memberEmail`, `memberPassword` if needed.\n3. Run the whole collection with the **Collection Runner** (Runner honours folder order): Auth → Organization → Frameworks → Assessments → Session → Dashboard → Infrastructure → Access-control. Login requests auto-save `accessToken` / `memberToken`; later requests auto-chain `orgId`, `frameworkId`, `assessmentId`, `sessionId`, `questionId`.\n\n## Notes\n- Collection-level auth is `Bearer {{accessToken}}` (admin). Member-scoped requests override it with `Bearer {{memberToken}}`.\n- Requests that invoke the LLM (Submit answer) are slower (~5-10s) and marked accordingly.\n- The live interview runs over WebSocket (`/ws/assessments/{sessionId}/chat`) which Postman's WS request type can open separately; REST endpoints below cover everything else.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after EVERY request in the collection.",
          "pm.test('Response time is reasonable (< 15s)', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(15000);",
          "});",
          "pm.test('Response is valid JSON', function () {",
          "  pm.response.to.be.withBody;",
          "  pm.response.to.be.json;",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "host", "value": "http://localhost:8001", "type": "string" },
    { "key": "baseUrl", "value": "{{host}}/api/v1", "type": "string" },
    { "key": "adminEmail", "value": "admin@zedny.com", "type": "string" },
    { "key": "adminPassword", "value": "Test@1234", "type": "string" },
    { "key": "memberEmail", "value": "it@zedny.com", "type": "string" },
    { "key": "memberPassword", "value": "Test@1234", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "memberToken", "value": "", "type": "string" },
    { "key": "orgId", "value": "", "type": "string" },
    { "key": "frameworkId", "value": "", "type": "string" },
    { "key": "assessmentId", "value": "", "type": "string" },
    { "key": "sessionId", "value": "", "type": "string" },
    { "key": "questionId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{host}}/health", "host": ["{{host}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.test('status is healthy', () => pm.expect(j.status).to.eql('healthy'));"
              ] }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register (create org + admin)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@newco-demo.com\",\n  \"password\": \"Test@1234\",\n  \"full_name\": \"New Co Admin\",\n  \"organization_name\": \"New Co (Postman)\",\n  \"department_name\": \"IT\",\n  \"position_name\": \"IT Administrator\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Creates a brand-new org + admin. Optional: only run when you want a fresh org (writes data). Disabled from the happy-path chain by default."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "// Accept 201 (created) or 409 (already exists) so re-runs don't fail.",
                "pm.test('created or already exists', () => pm.expect([200,201,409]).to.include(pm.response.code));"
              ] }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.test('returns access_token + refresh_token', () => {",
                "  pm.expect(j).to.have.property('access_token').that.is.a('string');",
                "  pm.expect(j).to.have.property('refresh_token').that.is.a('string');",
                "});",
                "pm.collectionVariables.set('accessToken', j.access_token);",
                "pm.collectionVariables.set('refreshToken', j.refresh_token);"
              ] }
            }
          ]
        },
        {
          "name": "Login (member)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.collectionVariables.set('memberToken', j.access_token);",
                "pm.test('member token saved', () => pm.expect(j.access_token).to.be.a('string'));"
              ] }
            }
          ]
        },
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const d = pm.response.json().data || pm.response.json();",
                "pm.test('returns the current user with a role', () => {",
                "  const u = d.user || d;",
                "  pm.expect(u).to.have.property('email');",
                "  pm.expect(u).to.have.property('role');",
                "});"
              ] }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.test('returns a new access_token', () => pm.expect(j.access_token).to.be.a('string'));",
                "if (j.access_token) pm.collectionVariables.set('accessToken', j.access_token);"
              ] }
            }
          ]
        }
      ]
    },
