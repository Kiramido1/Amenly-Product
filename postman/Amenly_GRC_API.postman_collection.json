          ]
        },
        {
          "name": "Launch campaign",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/assessments/{{assessmentId}}/launch", "host": ["{{baseUrl}}"], "path": ["assessments", "{{assessmentId}}", "launch"] },
            "description": "Admin lifecycle: opens the baseline phase. Writes state."
