              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const s = (pm.response.json().data || {}).sessions || [];",
                "pm.test('returns per-member session summaries', () => pm.expect(s).to.be.an('array'));"
              ] }
