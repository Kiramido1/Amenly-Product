    },
    {
      "name": "5. Assessment Session (Member)",
      "item": [
        {
          "name": "Start my session",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/assessments/{{assessmentId}}/sessions/start", "host": ["{{baseUrl}}"], "path": ["assessments", "{{assessmentId}}", "sessions", "start"] },
            "description": "Member starts their own position-scoped session. Requires member login + {{assessmentId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('201 Created', () => pm.expect([200,201]).to.include(pm.response.code));",
                "const d = pm.response.json().data || {};",
                "const s = d.session || {};",
                "pm.test('session started with id', () => pm.expect(s).to.have.property('id'));",
                "if (s.id) pm.collectionVariables.set('sessionId', s.id);",
                "const qs = d.questions || [];",
                "if (qs[0] && qs[0].id) pm.collectionVariables.set('questionId', qs[0].id);"
              ] }
            }
          ]
        },
        {
          "name": "Get my session",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/assessments/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["assessments", "sessions", "{{sessionId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));"
              ] }
            }
          ]
        },
        {
          "name": "Submit answer (AI-evaluated) [slow ~5-10s]",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"question_id\": \"{{questionId}}\",\n  \"answer_text\": \"We enforce MFA on all admin accounts via Azure AD, review access quarterly with sign-off, and apply least-privilege RBAC. We run 2 Windows Server 2019 domain controllers.\"\n}" },
            "url": { "raw": "{{baseUrl}}/assessments/answers", "host": ["{{baseUrl}}"], "path": ["assessments", "answers"] },
            "description": "Invokes the LLM evaluation engine — expect 5-10s. Returns a compliance score + remediation + regulation note."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('201 Created', () => pm.expect([200,201]).to.include(pm.response.code));",
                "const a = (pm.response.json().data || {}).answer || {};",
                "pm.test('answer scored by AI', () => {",
                "  pm.expect(a).to.have.property('compliance_score');",
                "  pm.expect(a.compliance_score).to.be.at.least(0);",
                "  pm.expect(a.compliance_score).to.be.at.most(100);",
                "});"
              ] }
            }
          ]
        },
        {
          "name": "Get chat history",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{memberToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/assessments/sessions/{{sessionId}}/chat", "host": ["{{baseUrl}}"], "path": ["assessments", "sessions", "{{sessionId}}", "chat"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const m = (pm.response.json().data || {}).messages || [];",
                "pm.test('returns a message list', () => pm.expect(m).to.be.an('array'));"
              ] }
            }
          ]
        }
      ]
    },
