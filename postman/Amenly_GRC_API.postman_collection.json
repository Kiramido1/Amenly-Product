          "name": "List frameworks",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/frameworks/", "host": ["{{baseUrl}}"], "path": ["frameworks", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const d = pm.response.json().data || {};",
                "const list = d.frameworks || [];",
                "pm.test('returns a framework list', () => pm.expect(list).to.be.an('array'));",
                "// Prefer an ISO 27001 framework; else take the first.",
                "const iso = list.find(f => /27001/.test(f.name)) || list[0];",
                "if (iso && iso.id) pm.collectionVariables.set('frameworkId', iso.id);"
              ] }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Assessments (Admin)",
      "item": [
        {
          "name": "List assessments",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/assessments", "host": ["{{baseUrl}}"], "path": ["assessments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const d = pm.response.json().data || {};",
                "const list = d.assessments || [];",
                "pm.test('returns assessments', () => pm.expect(list).to.be.an('array'));",
                "if (list[0]) {",
                "  pm.collectionVariables.set('assessmentId', list[0].id);",
                "  if (list[0].framework_id) pm.collectionVariables.set('frameworkId', list[0].framework_id);",
                "}"
              ] }
            }
          ]
        },
        {
          "name": "Create assessment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Assessment {{$timestamp}}\",\n  \"framework_id\": \"{{frameworkId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/assessments", "host": ["{{baseUrl}}"], "path": ["assessments"] },
            "description": "Creates a new assessment (admin only). Writes data. Requires {{frameworkId}} from 'List frameworks'."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('201 Created', () => pm.expect([200,201]).to.include(pm.response.code));",
                "const d = pm.response.json().data || {};",
                "const a = d.assessment || {};",
                "pm.test('assessment has id + framework_id', () => {",
                "  pm.expect(a).to.have.property('id');",
                "});",
                "// Do NOT overwrite assessmentId used by the happy path unless empty.",
                "if (a.id && !pm.collectionVariables.get('assessmentId')) pm.collectionVariables.set('assessmentId', a.id);"
              ] }
            }
          ]
        },
        {
          "name": "Get assessment",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/assessments/{{assessmentId}}", "host": ["{{baseUrl}}"], "path": ["assessments", "{{assessmentId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const a = (pm.response.json().data || {}).assessment || {};",
                "pm.test('matches requested id', () => pm.expect(a.id).to.eql(pm.collectionVariables.get('assessmentId')));"
              ] }
            }
          ]
        },
        {
          "name": "Campaign overview (before/after)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/assessments/{{assessmentId}}/overview", "host": ["{{baseUrl}}"], "path": ["assessments", "{{assessmentId}}", "overview"] }
          },
          "event": [
