          "name": "List campaign sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/assessments/{{assessmentId}}/sessions", "host": ["{{baseUrl}}"], "path": ["assessments", "{{assessmentId}}", "sessions"] }
